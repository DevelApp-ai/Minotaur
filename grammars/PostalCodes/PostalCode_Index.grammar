Grammar: PostalCode_Index
TokenSplitter: Space
FormatType: CEBNF

/*
 * Postal Code Grammar Index
 * 
 * Master index file for all postal code grammars in the Minotaur system.
 * This file provides a centralized way to access all country-specific postal code grammars.
 * 
 * Version: 2.0.0
 * Last Updated: 2025-01-15
 * Maintainer: DevelApp AI
 */

/* ============================================================================
 * MAIN INDEX RULE
 * ============================================================================ */

<postal-code-grammar> ::= 
    <postal-code-grammar-international> | 
    <postal-code-grammar-north-america> | 
    <postal-code-grammar-europe> | 
    <postal-code-grammar-asia> | 
    <postal-code-grammar-oceania> | 
    <postal-code-grammar-africa> | 
    <postal-code-grammar-south-america>

/* ============================================================================
 * INTERNATIONAL GRAMMARS
 * ============================================================================ */

<postal-code-grammar-international> ::= 
    <include>International_Postal_Codes.grammar</include>

/* ============================================================================
 * NORTH AMERICA GRAMMARS
 * ============================================================================ */

<postal-code-grammar-north-america> ::= 
    <include>US_Postal_Code.grammar</include> |
    <include>Canada_Postal_Code.grammar</include> |
    <include>Mexico_Postal_Code.grammar</include>

/* ============================================================================
 * EUROPE GRAMMARS
 * ============================================================================ */

<postal-code-grammar-europe> ::= 
    <include>UK_Postal_Code.grammar</include> |
