/* ============================================================================
 * COUNTRY CODE TO GRAMMAR MAPPING
 * ============================================================================ */

<country-to-grammar> ::= 
    /* North America */
    <country-code-US> <whitespace> "->" <whitespace> <include>US_Postal_Code.grammar</include> |
    <country-code-CA> <whitespace> "->" <whitespace> <include>Canada_Postal_Code.grammar</include> |
    <country-code-MX> <whitespace> "->" <whitespace> <include>Mexico_Postal_Code.grammar</include> |
    
    /* Europe */
    <country-code-GB> <whitespace> "->" <whitespace> <include>UK_Postal_Code.grammar</include> |
    <country-code-UK> <whitespace> "->" <whitespace> <include>UK_Postal_Code.grammar</include> |
    <country-code-DE> <whitespace> "->" <whitespace> <include>Germany_Postal_Code.grammar</include> |
    <country-code-FR> <whitespace> "->" <whitespace> <include>France_Postal_Code.grammar</include> |
    <country-code-IT> <whitespace> "->" <whitespace> <include>Italy_Postal_Code.grammar</include> |
    <country-code-ES> <whitespace> "->" <whitespace> <include>Spain_Postal_Code.grammar</include> |
    <country-code-NL> <whitespace> "->" <whitespace> <include>Netherlands_Postal_Code.grammar</include> |
    <country-code-BE> <whitespace> "->" <whitespace> <include>Belgium_Postal_Code.grammar</include> |
    <country-code-CH> <whitespace> "->" <whitespace> <include>Switzerland_Postal_Code.grammar</include> |
    <country-code-AT> <whitespace> "->" <whitespace> <include>Austria_Postal_Code.grammar</include> |
    <country-code-SE> <whitespace> "->" <whitespace> <include>Sweden_Postal_Code.grammar</include> |
    <country-code-NO> <whitespace> "->" <whitespace> <include>Norway_Postal_Code.grammar</include> |
    <country-code-FI> <whitespace> "->" <whitespace> <include>Finland_Postal_Code.grammar</include> |
    <country-code-DK> <whitespace> "->" <whitespace> <include>Denmark_Postal_Code.grammar</include> |
    <country-code-PL> <whitespace> "->" <whitespace> <include>Poland_Postal_Code.grammar</include> |
    <country-code-PT> <whitespace> "->" <whitespace> <include>Portugal_Postal_Code.grammar</include> |
    <country-code-IE> <whitespace> "->" <whitespace> <include>Ireland_Postal_Code.grammar</include> |
    <country-code-RU> <whitespace> "->" <whitespace> <include>Russia_Postal_Code.grammar</include> |
    
    /* Asia */
    <country-code-JP> <whitespace> "->" <whitespace> <include>Japan_Postal_Code.grammar</include> |
    <country-code-CN> <whitespace> "->" <whitespace> <include>China_Postal_Code.grammar</include> |
    <country-code-IN> <whitespace> "->" <whitespace> <include>India_Postal_Code.grammar</include> |
    <country-code-KR> <whitespace> "->" <whitespace> <include>South_Korea_Postal_Code.grammar</include> |
    <country-code-SG> <whitespace> "->" <whitespace> <include>Singapore_Postal_Code.grammar</include> |
    <country-code-HK> <whitespace> "->" <whitespace> <include>Hong_Kong_Postal_Code.grammar</include> |
    
    /* Oceania */
    <country-code-AU> <whitespace> "->" <whitespace> <include>Australia_Postal_Code.grammar</include> |
    <country-code-NZ> <whitespace> "->" <whitespace> <include>New_Zealand_Postal_Code.grammar</include> |
    
    /* Africa */
    <country-code-ZA> <whitespace> "->" <whitespace> <include>South_Africa_Postal_Code.grammar</include> |
    <country-code-EG> <whitespace> "->" <whitespace> <include>Egypt_Postal_Code.grammar</include> |
    
    /* South America */
    <country-code-BR> <whitespace> "->" <whitespace> <include>Brazil_Postal_Code.grammar</include> |
    <country-code-AR> <whitespace> "->" <whitespace> <include>Argentina_Postal_Code.grammar</include>

/* Country codes */
<country-code-US> ::= "US" | "USA" | "United States"
<country-code-CA> ::= "CA" | "CAN" | "Canada"
<country-code-MX> ::= "MX" | "MEX" | "Mexico"
<country-code-GB> ::= "GB" | "UK" | "United Kingdom"
<country-code-UK> ::= "UK" | "GB" | "United Kingdom"
