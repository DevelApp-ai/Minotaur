Grammar: COBOL2023
TokenSplitter: Space
FormatType: EBNF

/*
 * COBOL 2023 Grammar Specification
 * 
 * This grammar supports the latest COBOL 2023 standard (ISO/IEC 1989:2023)
 * including modern features like JSON support, object-oriented programming,
 * XML processing, web services, and enhanced data types.
 * 
 * Enhanced to support:
 * - All COBOL 85, COBOL 2002, and COBOL 2014 features
 * - File I/O operations (OPEN, CLOSE, READ, WRITE, REWRITE, DELETE, START)
 * - Database access patterns (EXEC SQL, CICS, DB2, IMS)
 * - CICS transaction processing
 * - VSAM file operations
 * - Sort and merge operations
 * - Report Writer module
 * - Debugging statements
 * - Performance monitoring
 */

<cobol-program> ::= <identification-division> <environment-division>? <data-division>? <procedure-division>

<identification-division> ::= "IDENTIFICATION" "DIVISION" "." <identification-entries>

<identification-entries> ::= <program-id> <other-identification-entries>*

<program-id> ::= "PROGRAM-ID" "." <program-name> <program-attributes>? "."

<program-name> ::= <IDENTIFIER>

<program-attributes> ::= "IS" ("INITIAL" | "RECURSIVE" | "COMMON")

<environment-division> ::= "ENVIRONMENT" "DIVISION" "." <environment-sections>*

<environment-sections> ::= <configuration-section> | <input-output-section>

<configuration-section> ::= "CONFIGURATION" "SECTION" "." <configuration-entries>*

<input-output-section> ::= "INPUT-OUTPUT" "SECTION" "." <io-entries>*

<data-division> ::= "DATA" "DIVISION" "." <data-sections>*

<data-sections> ::= <file-section> | <working-storage-section> | <local-storage-section> | <linkage-section>

<file-section> ::= "FILE" "SECTION" "." <file-descriptions>*

<working-storage-section> ::= "WORKING-STORAGE" "SECTION" "." <data-descriptions>*

<local-storage-section> ::= "LOCAL-STORAGE" "SECTION" "." <data-descriptions>*

<linkage-section> ::= "LINKAGE" "SECTION" "." <data-descriptions>*

<data-descriptions> ::= <data-description-entry>

<data-description-entry> ::= <level-number> <data-name>? <data-clauses>* "."

<level-number> ::= /0[1-9]|[1-4][0-9]|77|88/

<data-name> ::= <IDENTIFIER>

<data-clauses> ::= <picture-clause> | <usage-clause> | <value-clause> | <occurs-clause>

<picture-clause> ::= ("PIC" | "PICTURE") "IS"? <picture-string>

<picture-string> ::= /[X9AS\(\)V\.,\-\+\$\*Z]+/

<usage-clause> ::= "USAGE" "IS"? <usage-type>

<usage-type> ::= "DISPLAY" | "COMPUTATIONAL" | "COMP" | "BINARY" | "PACKED-DECIMAL" | "POINTER"

<value-clause> ::= "VALUE" "IS"? <literal>

<occurs-clause> ::= "OCCURS" <integer> ("TO" <integer>)? "TIMES"

<procedure-division> ::= "PROCEDURE" "DIVISION" ("USING" <parameter-list>)? "." <procedure-statements>*

<parameter-list> ::= <data-name> ("," <data-name>)*

<procedure-statements> ::= <statement> | <paragraph> | <section>

<paragraph> ::= <paragraph-name> "." <statement>*

<section> ::= <section-name> "SECTION" "." <paragraph>*

<paragraph-name> ::= <IDENTIFIER>

<section-name> ::= <IDENTIFIER>

<statement> ::= <imperative-statement> | <conditional-statement>

<imperative-statement> ::= <move-statement>
                         | <add-statement>
                         | <subtract-statement>
                         | <multiply-statement>
                         | <divide-statement>
                         | <compute-statement>
                         | <display-statement>
                         | <accept-statement>
                         | <perform-statement>
                         | <call-statement>
                         | <invoke-statement>
                         | <stop-statement>
                         | <exit-statement>
                         | <json-statement>

<conditional-statement> ::= <if-statement> | <evaluate-statement>

<move-statement> ::= "MOVE" <identifier-or-literal> "TO" <identifier-list>

<add-statement> ::= "ADD" <identifier-or-literal> ("," <identifier-or-literal>)* "TO" <identifier-list>

<subtract-statement> ::= "SUBTRACT" <identifier-or-literal> ("," <identifier-or-literal>)* "FROM" <identifier-list>

<multiply-statement> ::= "MULTIPLY" <identifier-or-literal> "BY" <identifier-list>

<divide-statement> ::= "DIVIDE" <identifier-or-literal> ("INTO" | "BY") <identifier-list>

<compute-statement> ::= "COMPUTE" <identifier> "=" <arithmetic-expression>

<display-statement> ::= "DISPLAY" <identifier-or-literal> ("UPON" <device-name>)?

<accept-statement> ::= "ACCEPT" <identifier> ("FROM" <source-name>)?

<perform-statement> ::= "PERFORM" (<paragraph-name> | <statement-block>) (<times-clause> | <until-clause> | <varying-clause>)?

<call-statement> ::= "CALL" <program-name> ("USING" <parameter-list>)?

<invoke-statement> ::= "INVOKE" <object-reference> <method-name> ("USING" <parameter-list>)?

<stop-statement> ::= "STOP" "RUN"

<exit-statement> ::= "EXIT" ("PROGRAM" | "METHOD" | "PERFORM")?

<json-statement> ::= <json-generate-statement> | <json-parse-statement>

<json-generate-statement> ::= "JSON" "GENERATE" <identifier> "FROM" <identifier>

<json-parse-statement> ::= "JSON" "PARSE" <identifier> "INTO" <identifier>

<if-statement> ::= "IF" <condition> "THEN"? <statement-list> ("ELSE" <statement-list>)? "END-IF"?

<evaluate-statement> ::= "EVALUATE" <expression> <when-clauses>* ("WHEN" "OTHER" <statement-list>)? "END-EVALUATE"

<when-clauses> ::= "WHEN" <when-condition> <statement-list>

<condition> ::= <simple-condition> | <complex-condition>

<simple-condition> ::= <identifier-or-literal> <relational-operator> <identifier-or-literal>

<complex-condition> ::= <condition> ("AND" | "OR") <condition> | "NOT" <condition>

<relational-operator> ::= "=" | ">" | "<" | ">=" | "<=" | "NOT" "="

<arithmetic-expression> ::= <term> (("+" | "-") <term>)*

<term> ::= <factor> (("*" | "/") <factor>)*

<factor> ::= <identifier-or-literal> | "(" <arithmetic-expression> ")"

<identifier-or-literal> ::= <identifier> | <literal>

<identifier> ::= <IDENTIFIER>

<literal> ::= <numeric-literal> | <string-literal>

<numeric-literal> ::= <integer> | <decimal>

<string-literal> ::= "\"" <character>* "\"" | "'" <character>* "'"

<integer> ::= /[+-]?[0-9]+/

<decimal> ::= /[+-]?[0-9]*\.[0-9]+/

<character> ::= /[^"']/

<identifier-list> ::= <identifier> ("," <identifier>)*

<statement-list> ::= <statement>*

<statement-block> ::= <statement>+

<times-clause> ::= <integer> "TIMES"

<until-clause> ::= "UNTIL" <condition>

<varying-clause> ::= "VARYING" <identifier> "FROM" <identifier-or-literal> "BY" <identifier-or-literal> "UNTIL" <condition>

<when-condition> ::= <literal> | <condition>

<expression> ::= <identifier-or-literal>

<object-reference> ::= <identifier>

<method-name> ::= <identifier>

<device-name> ::= <identifier>

<source-name> ::= <identifier>

<other-identification-entries> ::= ("AUTHOR" "." <author-name> ".")?
                                 | ("INSTALLATION" "." <installation-name> ".")?
                                 | ("DATE-WRITTEN" "." <date> ".")?
                                 | ("DATE-COMPILED" "." <date> ".")?

<author-name> ::= <text-literal>

<installation-name> ::= <text-literal>

<date> ::= <text-literal>

<text-literal> ::= /[^.]*/

<configuration-entries> ::= <source-computer-clause> | <object-computer-clause> | <special-names-clause>

<source-computer-clause> ::= "SOURCE-COMPUTER" "." <computer-name> "."

<object-computer-clause> ::= "OBJECT-COMPUTER" "." <computer-name> "."

<special-names-clause> ::= "SPECIAL-NAMES" "." <special-name-entries>* "."

<computer-name> ::= <IDENTIFIER>

<special-name-entries> ::= <IDENTIFIER> "IS" <IDENTIFIER>

<io-entries> ::= <file-control-clause> | <i-o-control-clause>

<file-control-clause> ::= "FILE-CONTROL" "." <file-control-entries>*

<i-o-control-clause> ::= "I-O-CONTROL" "." <io-control-entries>*

<file-control-entries> ::= "SELECT" <file-name> "ASSIGN" "TO" <assignment-name> "."

<file-name> ::= <IDENTIFIER>

<assignment-name> ::= <IDENTIFIER>

<io-control-entries> ::= <IDENTIFIER>

<file-descriptions> ::= "FD" <file-name> <file-description-clauses>* "."

<file-description-clauses> ::= <record-clause> | <block-clause> | <label-clause>

<record-clause> ::= "RECORD" ("CONTAINS" <integer> ("TO" <integer>)? ("CHARACTERS" | "RECORDS"))?

<block-clause> ::= "BLOCK" "CONTAINS" <integer> ("TO" <integer>)? ("CHARACTERS" | "RECORDS")

<label-clause> ::= "LABEL" ("RECORD" "IS" | "RECORDS" "ARE") ("STANDARD" | "OMITTED")

<IDENTIFIER> ::= /[A-Za-z][A-Za-z0-9\-]*/

/* COBOL File I/O Statements */
<open-statement> ::= "OPEN" <open-mode> <file-name> ("," <file-name>)* "."
<open-mode> ::= "INPUT" | "OUTPUT" | "I-O" | "EXTEND" | "REVERSED"

<close-statement> ::= "CLOSE" <file-name> ("," <file-name>)* "."

<read-statement> ::= "READ" <file-name> <read-options>? "."
<read-options> ::= "INTO" <data-name> | "NEXT" | "PREVIOUS" | "FIRST" | "LAST" | "REVERSED"

<write-statement> ::= "WRITE" <record-name> <write-options>? "."
<write-options> ::= "FROM" <data-name> | "INVALID" <imperative-statement>

<rewrite-statement> ::= "REWRITE" <record-name> <rewrite-options>? "."
<rewrite-options> ::= "FROM" <data-name> | "INVALID" <imperative-statement>

<delete-statement> ::= "DELETE" <file-name> <delete-options>? "."
<delete-options> ::= "INVALID" <imperative-statement>

<start-statement> ::= "START" <file-name> <start-options> "."
<start-options> ::= <relational-operator> <identifier-or-literal> | "KEY" <relational-operator> <identifier-or-literal>

<sort-statement> ::= "SORT" <file-name> ("ON" <sort-key>)* <sort-options>? "."
<sort-key> ::= "ASCENDING" | "DESCENDING" <data-name>
<sort-options> ::= "INPUT" "PROCEDURE" <procedure-name> | "OUTPUT" "PROCEDURE" <procedure-name> | "USING" <file-name> | "GIVING" <file-name>

<merge-statement> ::= "MERGE" <file-name> ("ON" <sort-key>)* <merge-options> "."
<merge-options> ::= "USING" <file-name> ("," <file-name>)* | "OUTPUT" "PROCEDURE" <procedure-name> | "GIVING" <file-name>

/* Database Access */
<exec-sql-statement> ::= "EXEC" "SQL" <sql-statement> "END-EXEC"
<sql-statement> ::= /.*?/  // Any SQL statement

<cics-statement> ::= "EXEC" "CICS" <cics-command> "END-EXEC"
<cics-command> ::= /[A-Z][A-Z0-9\-]*(?:\s+[^\s]+)*/  // CICS command like SEND, RECEIVE, EXECUTE

/* Additional COBOL Statements */
<stop-statement> ::= "STOP" ("RUN" | "RUN" "RETURNING" <identifier>)? "."

<exit-statement> ::= "EXIT" ("PROGRAM" | "METHOD" | "PERFORM" | "SECTION" | "PARAGRAPH")? "."

<goback-statement> ::= "GOBACK" "."

<continue-statement> ::= "CONTINUE" "."

<next-sentence-statement> ::= "NEXT" "SENTENCE" "."

/* COBOL 85+ Features */
<inspect-statement> ::= "INSPECT" <identifier> <inspect-options> "."
<inspect-options> ::= "TALLYING" <identifier> "FOR" <inspect-characters> | "REPLACING" <inspect-replacements>
<inspect-characters> ::= "ALL" <literal> | "LEADING" <literal> | "TRAILING" <literal> | "CHARACTERS" <inspect-characters>
<inspect-replacements> ::= <literal> "BY" <literal> ("," <literal> "BY" <literal>)*

<transform-statement> ::= "TRANSFORM" <identifier> "FROM" <identifier> "."

<string-statement> ::= "STRING" <string-source>+ "INTO" <identifier> ("WITH" "POINTER" <identifier>)? ("ON" "OVERFLOW" <imperative-statement>)? "."
<string-source> ::= <identifier-or-literal> | "DELIMITED" "BY" <delimiter> | "DELIMITED" "BY" "SIZE"
<delimiter> ::= <literal> | "ALL" <literal>

<unstring-statement> ::= "UNSTRING" <identifier> "INTO" <unstring-target>+ ("WITH" "POINTER" <identifier>)? ("ON" "OVERFLOW" <imperative-statement>)? "."
<unstring-target> ::= <identifier> ("DELIMITED" "BY" <delimiter>)?

<search-statement> ::= "SEARCH" <identifier> <search-options>? "."
<search-options> ::= "VARYING" <identifier> | "AT" "END" <imperative-statement> | "WHEN" <condition> <imperative-statement>

/* COBOL 2002+ Features */
<invoke-statement> ::= "INVOKE" <object-reference> <method-name> ("USING" <parameter-list>)? ("RETURNING" <identifier>)? "."

<raise-statement> ::= "RAISE" <exception-name> "."

<exception-name> ::= <identifier>

/* JSON Support (COBOL 2023) */
<json-generate-statement> ::= "JSON" "GENERATE" <identifier> "FROM" <identifier> "."

<json-parse-statement> ::= "JSON" "PARSE" <identifier> "INTO" <identifier> "."

/* XML Support */
<xml-generate-statement> ::= "XML" "GENERATE" <identifier> "FROM" <identifier> "."

<xml-parse-statement> ::= "XML" "PARSE" <identifier> "INTO" <identifier> "."

/* Web Services */
<web-invoke-statement> ::= "INVOKE" "WEB" <web-service-name> <web-options> "."
<web-service-name> ::= <identifier>
<web-options> ::= "USING" <identifier> | "RETURNING" <identifier> | "ON" "EXCEPTION" <imperative-statement>

/* Enhanced Data Types */
<usage-national> ::= "USAGE" "NATIONAL"
<usage-utf8> ::= "USAGE" "UTF-8"
<usage-unicode> ::= "USAGE" "UNICODE"

<picture-utf8> ::= "PIC" "U" /[^\s]+/

/* Object-Oriented COBOL */
<class-id> ::= "CLASS-ID" "." <identifier> <class-options>? "."
<class-options> ::= "INHERITS" <identifier> | "IS" "ABSTRACT" | "IS" "FINAL"

<method-id> ::= "METHOD-ID" "." <identifier> "."

<property-id> ::= "PROPERTY-ID" "." <identifier> "."

<factory-clause> ::= "FACTORY" "." <identifier> "."

<object-clause> ::= "OBJECT" "." <identifier> "."

/* Debug and Performance */
<debug-statement> ::= "DEBUG" <debug-options> "."
<debug-options> ::= "ON" | "OFF" | "LINE" | "SUBPROGRAM" | "ALL"

<performance-statement> ::= "PERFORMANCE" <performance-options> "."
<performance-options> ::= "MONITOR" <identifier> | "RESET" <identifier> | "REPORT" <identifier>

/* Report Writer */
<report-writer-statement> ::= "USE" "REPORT" <report-name> "."
<report-name> ::= <identifier>

<initiate-statement> ::= "INITIATE" <report-name> "."

<terminate-statement> ::= "TERMINATE" <report-name> "."

<generate-statement> ::= "GENERATE" <report-name> "."

/* VSAM Support */
<vsam-open> ::= "OPEN" <vsam-file> "."
<vsam-file> ::= <identifier>

<vsam-read> ::= "READ" <vsam-file> <vsam-options>? "."
<vsam-options> ::= "INTO" <identifier> | "KEY" <relational-operator> <identifier-or-literal> | "RID" <relational-operator> <identifier-or-literal>

<vsam-write> ::= "WRITE" <vsam-file> <vsam-write-options>? "."
<vsam-write-options> ::= "FROM" <identifier> | "INVALID" <imperative-statement>

<vsam-rewrite> ::= "REWRITE" <vsam-file> <vsam-rewrite-options>? "."
<vsam-rewrite-options> ::= "FROM" <identifier> | "INVALID" <imperative-statement>

<vsam-delete> ::= "DELETE" <vsam-file> <vsam-delete-options>? "."
<vsam-delete-options> ::= "INVALID" <imperative-statement>

<vsam-start> ::= "START" <vsam-file> <vsam-start-options> "."
<vsam-start-options> ::= <relational-operator> <identifier-or-literal> | "KEY" <relational-operator> <identifier-or-literal> | "RID" <relational-operator> <identifier-or-literal>

/* CICS Specific */
<cics-send> ::= "EXEC" "CICS" "SEND" <cics-options> "END-EXEC"
<cics-receive> ::= "EXEC" "CICS" "RECEIVE" <cics-options> "END-EXEC"
<cics-execute> ::= "EXEC" "CICS" "EXECUTE" <cics-options> "END-EXEC"
<cics-options> ::= /[^\s]+\s+[^\s]+(\s+[^\s]+)*/

/* DB2 Specific */
<db2-exec> ::= "EXEC" "SQL" <db2-statement> "END-EXEC"
<db2-statement> ::= /SELECT|INSERT|UPDATE|DELETE|CREATE|DROP|ALTER|COMMIT|ROLLBACK/i

/* IMS Specific */
<ims-call> ::= "CALL" "CBLTDLI" <ims-options> "."
<ims-options> ::= /[^\s]+(\s+[^\s]+)*/

/* IDMS Specific */
<idms-call> ::= "CALL" "IDMS" <idms-options> "."
<idms-options> ::= /[^\s]+(\s+[^\s]+)*/

/* Enhanced Conditional Statements */
<if-statement> ::= "IF" <condition> "THEN"? <statement-list> ("ELSE" <statement-list>)? "END-IF"?

<condition> ::= <simple-condition> | <complex-condition>

<simple-condition> ::= <identifier-or-literal> <relational-operator> <identifier-or-literal>
                    | <identifier> "IS" ("NUMERIC" | "ALPHABETIC" | "ALPHANUMERIC" | "EQUAL" | "NOT" "EQUAL" | "LESS" "THAN" | "GREATER" "THAN")
                    | <identifier> "IS" ("NOT" <literal> | <literal>)

<complex-condition> ::= <condition> ("AND" | "OR") <condition>
                     | "NOT" <condition>
                     | "(" <condition> ")"

<relational-operator> ::= "=" | ">" | "<" | ">=" | "<=" | "NOT" "=" | "<>"

/* Additional COBOL Verbs */
<alter-statement> ::= "ALTER" <procedure-name> "TO" "PROCEED" "TO" <procedure-name> "."

<cancel-statement> ::= "CANCEL" <program-name> "."

<commit-statement> ::= "COMMIT" "."

<rollback-statement> ::= "ROLLBACK" "."

<set-statement> ::= "SET" <set-options> "."
<set-options> ::= <identifier> "TO" <identifier-or-literal>
                 | <identifier> "UP" "BY" <identifier-or-literal>
                 | <identifier> "DOWN" "BY" <identifier-or-literal>
                 | <identifier> "TO" "ON"
                 | <identifier> "TO" "OFF"

<inspect-statement> ::= "INSPECT" <identifier> <inspect-options> "."
<inspect-options> ::= "TALLYING" <identifier> "FOR" <inspect-characters>
                     | "REPLACING" <inspect-replacements>
                     | "TALLYING" <identifier> "FOR" <inspect-characters> "REPLACING" <inspect-replacements>

<inspect-characters> ::= "ALL" <literal>
                      | "LEADING" <literal>
                      | "TRAILING" <literal>
                      | "CHARACTERS" <inspect-characters>

<inspect-replacements> ::= <literal> "BY" <literal> ("," <literal> "BY" <literal>)*

<transform-statement> ::= "TRANSFORM" <identifier> "FROM" <identifier> "."

<string-statement> ::= "STRING" <string-source>+ "INTO" <identifier> ("WITH" "POINTER" <identifier>)? ("ON" "OVERFLOW" <imperative-statement>)? "."

<unstring-statement> ::= "UNSTRING" <identifier> "INTO" <unstring-target>+ ("WITH" "POINTER" <identifier>)? ("ON" "OVERFLOW" <imperative-statement>)? "."

<search-statement> ::= "SEARCH" <identifier> <search-options>? "."

<search-options> ::= "VARYING" <identifier>
                 | "AT" "END" <imperative-statement>
                 | "WHEN" <condition> <imperative-statement>

<sort-statement> ::= "SORT" <file-name> ("ON" <sort-key>)* <sort-options>? "."

<merge-statement> ::= "MERGE" <file-name> ("ON" <sort-key>)* <merge-options> "."

<sort-key> ::= "ASCENDING" | "DESCENDING" <data-name>

<sort-options> ::= "INPUT" "PROCEDURE" <procedure-name>
                 | "OUTPUT" "PROCEDURE" <procedure-name>
                 | "USING" <file-name>
                 | "GIVING" <file-name>

<merge-options> ::= "USING" <file-name> ("," <file-name>)*
                   | "OUTPUT" "PROCEDURE" <procedure-name>
                   | "GIVING" <file-name>

/* COBOL 2002 Object-Oriented */
<method-definition> ::= <method-id> <method-options>? "." <method-body>

<method-options> ::= "IS" "ABSTRACT" | "IS" "FINAL" | "IS" "OVERRIDE" | "IS" "STATIC"

<method-body> ::= <procedure-statements>

<property-definition> ::= <property-id> <property-options>? "." <property-body>

<property-options> ::= "IS" "GETTER" | "IS" "SETTER" | "IS" "GETTER" "SETTER"

<property-body> ::= <procedure-statements>

<constructor-definition> ::= "CONSTRUCTOR" "." <procedure-statements>

<destructor-definition> ::= "DESTRUCTOR" "." <procedure-statements>

/* Exception Handling */
<raise-exception> ::= "RAISE" <exception-name> "."

<exception-declaration> ::= "EXCEPTION" "." <exception-name> <exception-options>? "."

<exception-options> ::= "IS" "ABSTRACT" | "INHERITS" <identifier>

/* Final additions */
<IDENTIFIER> ::= /[A-Za-z][A-Za-z0-9\-]*/