 * See LICENSE file in the project root for full license information.
 *
 * @code {
 *   <SymbolSearch OnSymbolSelected="HandleSymbolSelected" />
 * }
 *
 * @inject SymbolSearchService - Service for symbol search
 * @implements IDisposable - To clean up event handlers
 * *@

@using Minotaur.Core.Models.Editor
@using Minotaur.Core.Services.Editor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="symbol-search-container @ThemeClass" style="@ContainerStyle">
    <div class="search-header">
        <input type="text" 
               class="search-input" 
               @bind="SearchQuery" 
               @bind:event="oninput"
               placeholder="Search symbols..."
               @onkeydown="HandleKeyDown" />
        
        <button class="search-button" @onclick="PerformSearch" title="Search">
            <span class="search-icon">&#128269;</span>
        </button>
        
        <button class="clear-button" @onclick="ClearSearch" title="Clear">
            <span class="clear-icon">&#10005;</span>
        </button>
    </div>
    
    <div class="search-filters">
        <div class="filter-group">
            <label class="filter-label">Language:</label>
            <select class="filter-select" @bind="LanguageFilter" @onchange="PerformSearch">
                <option value="">All Languages</option>
                @foreach (var lang in SupportedLanguages)
                {
                    <option value="@lang.LanguageId">@lang.DisplayName</option>
                }
            </select>
        </div>
        
        <div class="filter-group">
            <label class="filter-label">Type:</label>
            <select class="filter-select" @bind="TypeFilter" @onchange="PerformSearch">
                <option value="">All Types</option>
                @foreach (var type in Enum.GetValues(typeof(SymbolType)).Cast<SymbolType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        
        <div class="filter-group">
            <label class="filter-check">
                <input type="checkbox" @bind="IncludeReferences" @onchange="PerformSearch" />
                <span>Include References</span>
            </label>
        </div>
    </div>
    
    <div class="search-results">
        @if (IsSearching)
        {
            <div class="loading-indicator">Searching...</div>
        }
        else if (Results != null && Results.HasResults)
        {
            <div class="results-count">@Results.TotalResults results found</div>
            
            @if (Results.Symbols != null && Results.Symbols.Any())
            {
                <div class="results-section">
                    <div class="section-title">Symbols</div>
                    @foreach (var symbol in Results.Symbols)
                    {
                        <div class="result-item symbol-item" @onclick="() => SelectSymbol(symbol)">
                            <div class="symbol-type @GetTypeClass(symbol.Type)">@symbol.Type</div>
                            <div class="symbol-name">@symbol.Name</div>
                            <div class="symbol-location">@symbol.FilePath:@symbol.Line:@symbol.Column</div>
                        </div>
                    }
                </div>
            }
            
            @if (Results.References != null && Results.References.Any())
            {
                <div class="results-section">
                    <div class="section-title">References</div>
                    @foreach (var reference in Results.References)
                    {
                        <div class="result-item reference-item" @onclick="() => SelectReference(reference)">
                            <div class="reference-name">@reference.SymbolName</div>
                            <div class="reference-location">@reference.FilePath:@reference.Line:@reference.Column</div>
                        </div>
                    }
                </div>
            }
        }
        else if (!string.IsNullOrEmpty(SearchQuery))
        {
            <div class="no-results">No results found</div>
        }
        else
        {
            <div class="search-placeholder">Enter a search query to find symbols</div>
        }
    </div>
    
    <div class="search-footer">
        <div class="keyboard-shortcuts">
            <span>Shortcuts: </span>
            <span>Ctrl+F - Focus search</span>
            <span>Enter - Search</span>
            <span>Esc - Clear</span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public string LanguageId { get; set; } = "csharp";

    [Parameter]
    public Theme Theme { get; set; } = Theme.System;

    [Parameter]
    public string ContainerStyle { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<SymbolInfo> OnSymbolSelected { get; set; }

    [Parameter]
    public EventCallback<SymbolReference> OnReferenceSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSearchPerformed { get; set; }

    [Inject]
    public ISymbolSearchService SearchService { get; set; }

    private string SearchQuery { get; set; } = string.Empty;
    private string LanguageFilter { get; set; } = string.Empty;
    private SymbolType? TypeFilter { get; set; } = null;
    private bool IncludeReferences { get; set; } = true;
    private bool IsSearching { get; set; } = false;
    private SymbolSearchResult Results { get; set; } = new SymbolSearchResult();
    private List<LanguageSymbolRules> SupportedLanguages { get; set; } = new List<LanguageSymbolRules>();
    private string ThemeClass => GetThemeClass();
    private bool IsDarkTheme => Theme == Theme.Dark || (Theme == Theme.System && IsSystemDark);
    private bool IsSystemDark { get; set; } = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        InitializeSupportedLanguages();
    }

    private void InitializeSupportedLanguages()
    {
        // Get supported languages from the search service
        // This would be populated from the actual service in a real implementation
        SupportedLanguages = new List<LanguageSymbolRules>
        {
            new LanguageSymbolRules { LanguageId = "csharp", DisplayName = "C#" },
            new LanguageSymbolRules { LanguageId = "java", DisplayName = "Java" },
            new LanguageSymbolRules { LanguageId = "javascript", DisplayName = "JavaScript" },
            new LanguageSymbolRules { LanguageId = "typescript", DisplayName = "TypeScript" },
            new LanguageSymbolRules { LanguageId = "python", DisplayName = "Python" },
            new LanguageSymbolRules { LanguageId = "cobol", DisplayName = "COBOL" },
            new LanguageSymbolRules { LanguageId = "pli", DisplayName = "PL/I" },
            new LanguageSymbolRules { LanguageId = "rust", DisplayName = "Rust" },
            new LanguageSymbolRules { LanguageId = "go", DisplayName = "Go" }
        };
    }

    private string GetThemeClass()
    {
        if (Theme == Theme.Dark)
            return "dark-theme";
        else if (Theme == Theme.Light)
            return "light-theme";
        else
            return IsSystemDark ? "dark-theme" : "light-theme";
    }

    private string GetTypeClass(SymbolType type)
    {
        return type.ToString().ToLower();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
        else if (e.Key == "Escape")
        {
            ClearSearch();
        }
        else if (e.CtrlKey && e.Key == "f")
        {
            e.PreventDefault();
            // Focus the search input
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            Results = new SymbolSearchResult();
            StateHasChanged();
            return;
        }

        IsSearching = true;
        StateHasChanged();

        try
        {
            // In a real implementation, this would search across multiple files
            // For now, we'll build an index from the provided code
            var index = SearchService.BuildIndex(Code, LanguageId, "current");
            
            // Search for symbols
            var symbols = SearchService.SearchSymbols(
                SearchQuery, 
                string.IsNullOrEmpty(LanguageFilter) ? null : LanguageFilter,
                TypeFilter);
            
            // Search for references
            var references = IncludeReferences ? 
                SearchService.GetSymbolReferences(SearchQuery, string.IsNullOrEmpty(LanguageFilter) ? null : LanguageFilter) :
                new List<SymbolReference>();

            Results = new SymbolSearchResult
            {
                Query = SearchQuery,
                Symbols = symbols,
                References = references,
                LanguageFilter = string.IsNullOrEmpty(LanguageFilter) ? null : LanguageFilter,
                TypeFilter = TypeFilter
            };

            await OnSearchPerformed.InvokeAsync(SearchQuery);
        }
        catch (Exception ex)
        {
            // Handle error
            Results = new SymbolSearchResult
            {
                Query = SearchQuery,
                Symbols = new List<SymbolInfo>(),
                References = new List<SymbolReference>()
            };
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        Results = new SymbolSearchResult();
        StateHasChanged();
    }

    private void SelectSymbol(SymbolInfo symbol)
    {
        OnSymbolSelected.InvokeAsync(symbol);
    }

    private void SelectReference(SymbolReference reference)
    {
        OnReferenceSelected.InvokeAsync(reference);
    }

    public void SetLanguage(string languageId)
    {
        LanguageId = languageId;
        StateHasChanged();
    }

    public void SetTheme(Theme theme)
    {
        Theme = theme;
        StateHasChanged();
    }

    public void SetCode(string code, string languageId)
    {
        Code = code;
        LanguageId = languageId;
        StateHasChanged();
    }

    public void Focus()
    {
        // Focus the search input
        StateHasChanged();
    }

    public void Dispose()
    {
        // Clean up any resources
    }
}

<style>
    .symbol-search-container {
        display: flex;
        flex-direction: column;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 14px;
        background-color: var(--bg-color, #ffffff);
        color: var(--text-color, #000000);
        border: 1px solid var(--border-color, #cccccc);
        border-radius: 4px;
        width: 100%;
        max-width: 600px;
    }

    .symbol-search-container.dark-theme {
        --bg-color: #2d2d2d;
        --text-color: #d4d4d4;
        --border-color: #444444;
        --input-bg: #1e1e1e;
        --input-text: #d4d4d4;
        --input-border: #444444;
        --button-bg: #3d3d3d;
        --button-text: #d4d4d4;
        --button-hover: #4d4d4d;
        --results-bg: #252526;
        --results-border: #3d3d3d;
        --results-text: #d4d4d4;
        --results-secondary: #888888;
        --highlight-bg: #264f78;
        --highlight-text: #ffffff;
    }

    .symbol-search-container.light-theme {
        --bg-color: #ffffff;
        --text-color: #000000;
        --border-color: #cccccc;
        --input-bg: #ffffff;
        --input-text: #000000;
        --input-border: #cccccc;
        --button-bg: #f0f0f0;
        --button-text: #000000;
        --button-hover: #e0e0e0;
        --results-bg: #f5f5f5;
        --results-border: #dddddd;
        --results-text: #000000;
        --results-secondary: #666666;
        --highlight-bg: #007acc;
        --highlight-text: #ffffff;
    }

    .search-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background-color: var(--input-bg);
        border-bottom: 1px solid var(--border-color);
    }

    .search-input {
        flex: 1;
        padding: 6px 12px;
        font-size: 14px;
        border: 1px solid var(--input-border);
        border-radius: 4px;
        background-color: var(--input-bg);
        color: var(--input-text);
        outline: none;
        transition: border-color 0.2s;
    }

    .search-input:focus {
        border-color: var(--highlight-bg);
    }

    .search-button, .clear-button {
        padding: 6px 12px;
        font-size: 14px;
        background-color: var(--button-bg);
        color: var(--button-text);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .search-button:hover, .clear-button:hover {
        background-color: var(--button-hover);
    }

    .search-icon, .clear-icon {
        font-size: 16px;
    }

    .search-filters {
        display: flex;
        gap: 16px;
        padding: 8px;
        background-color: var(--results-bg);
        border-bottom: 1px solid var(--border-color);
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-label {
        font-size: 12px;
        color: var(--results-secondary);
    }

    .filter-select {
        padding: 4px 8px;
        font-size: 12px;
        border: 1px solid var(--border-color);
        border-radius: 3px;
        background-color: var(--input-bg);
        color: var(--input-text);
        outline: none;
    }

    .filter-check {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: var(--results-secondary);
    }

    .filter-check input[type="checkbox"] {
        cursor: pointer;
    }

    .search-results {
        flex: 1;
        overflow-y: auto;
        max-height: 400px;
        background-color: var(--results-bg);
    }

    .loading-indicator {
        padding: 16px;
        text-align: center;
        color: var(--results-secondary);
    }

    .results-count {
        padding: 8px 16px;
        font-size: 12px;
        color: var(--results-secondary);
        border-bottom: 1px solid var(--border-color);
    }

    .results-section {
        padding: 8px;
    }

    .section-title {
        font-size: 12px;
        font-weight: bold;
        color: var(--results-secondary);
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .result-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .result-item:hover {
        background-color: var(--highlight-bg);
        color: var(--highlight-text);
    }

    .symbol-item {
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: 8px;
    }

    .symbol-type {
        font-size: 11px;
        padding: 2px 6px;
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 3px;
        text-align: center;
        color: var(--results-secondary);
    }

    .symbol-name {
        font-weight: bold;
        color: var(--results-text);
    }

    .symbol-location {
        font-size: 11px;
        color: var(--results-secondary);
        text-align: right;
    }

    .reference-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
    }

    .reference-name {
        font-weight: bold;
        color: var(--results-text);
    }

    .reference-location {
        font-size: 11px;
        color: var(--results-secondary);
        text-align: right;
    }

    .no-results, .search-placeholder {
        padding: 16px;
        text-align: center;
        color: var(--results-secondary);
        font-style: italic;
    }

    .search-footer {
        padding: 8px;
        background-color: var(--results-bg);
        border-top: 1px solid var(--border-color);
    }

    .keyboard-shortcuts {
        display: flex;
        gap: 16px;
        font-size: 11px;
        color: var(--results-secondary);
    }

    /* Type-specific colors */
    .symbol-item .class {
        background-color: #4EC9B0;
        color: #ffffff;
    }

    .symbol-item .interface {
        background-color: #569CD6;
        color: #ffffff;
    }

    .symbol-item .struct {
        background-color: #CE9178;
        color: #ffffff;
    }

    .symbol-item .enum {
        background-color: #B5CEA8;
        color: #000000;
    }

    .symbol-item .method, .symbol-item .function {
        background-color: #DCDCAA;
        color: #000000;
    }

    .symbol-item .variable {
        background-color: #9CDCFE;
        color: #000000;
    }

    .symbol-item .field, .symbol-item .property {
        background-color: #C586C0;
        color: #ffffff;
    }

    .dark-theme .symbol-item .class {
        background-color: #1E88A8;
        color: #ffffff;
    }

    .dark-theme .symbol-item .interface {
        background-color: #267F99;
        color: #ffffff;
    }

    .dark-theme .symbol-item .struct {
        background-color: #A569BD;
        color: #ffffff;
    }

    .dark-theme .symbol-item .enum {
        background-color: #489B3F;
        color: #ffffff;
    }

    .dark-theme .symbol-item .method, .dark-theme .symbol-item .function {
        background-color: #B79F00;
        color: #ffffff;
    }

    .dark-theme .symbol-item .variable {
        background-color: #4FC1FF;
        color: #000000;
    }

    .dark-theme .symbol-item .field, .dark-theme .symbol-item .property {
        background-color: #A569BD;
        color: #ffffff;
    }
</style>
