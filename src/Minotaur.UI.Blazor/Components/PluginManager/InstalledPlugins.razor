</style>

@code {
    [Parameter]
    public List<PluginInfo> Plugins { get; set; } = new();

    [Parameter]
    public EventCallback<PluginInfo> OnPluginToggle { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnPluginConfigure { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnPluginUninstall { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private string searchText = string.Empty;
    private string sortBy = "name";
    private string filterStatus = string.Empty;
    private bool selectAll = false;
    private List<PluginUpdateInfo> updatesAvailable = new();

    private List<PluginInfo> filteredPlugins =>
        Plugins
        .Where(p => string.IsNullOrWhiteSpace(searchText) || 
                   p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                   p.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                   p.Author.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(filterStatus) || 
                   (filterStatus == "enabled" && p.IsEnabled) ||
                   (filterStatus == "disabled" && !p.IsEnabled))
        .OrderBy(p => sortBy switch
        {
            "name" => p.Name,
            "version" => p.Version,
            "date" => p.InstallDate,
            "status" => p.IsEnabled ? 0 : 1,
            _ => p.Name
        })
        .ToList();

    private void TogglePlugin(PluginInfo plugin)
    {
        plugin.IsEnabled = !plugin.IsEnabled;
        OnPluginToggle.InvokeAsync(plugin);
    }

    private void ConfigurePlugin(PluginInfo plugin)
    {
        OnPluginConfigure.InvokeAsync(plugin);
    }

    private void UninstallPlugin(PluginInfo plugin)
    {
        OnPluginUninstall.InvokeAsync(plugin);
    }

    private void RefreshPlugins()
    {
        OnRefresh.InvokeAsync();
    }

    private void CheckForUpdates()
    {
        // TODO: Implement update checking
        // For now, just clear any existing updates
        updatesAvailable.Clear();
    }

    private void EnableSelected()
    {
        foreach (var plugin in filteredPlugins)
        {
            if (plugin.IsEnabled) continue;
            plugin.IsEnabled = true;
            OnPluginToggle.InvokeAsync(plugin);
        }
    }

    private void DisableSelected()
    {
        foreach (var plugin in filteredPlugins)
        {
            if (!plugin.IsEnabled) continue;
            plugin.IsEnabled = false;
            OnPluginToggle.InvokeAsync(plugin);
        }
    }

    private void UninstallSelected()
    {
        foreach (var plugin in filteredPlugins)
        {
            OnPluginUninstall.InvokeAsync(plugin);
        }
    }

    private void UpdatePlugin(PluginUpdateInfo update)
    {
        // TODO: Implement update logic
    }

    private string GetPluginIcon(PluginInfo plugin)
    {
        return plugin.Category switch
        {
            "language" => "bi-translate",
            "visualization" => "bi-diagram-3",
            "export" => "bi-box-arrow-up-right",
            "analysis" => "bi-graph-up",
            "theme" => "bi-palette",
            _ => "bi-puzzle"
        };
    }

    private string GetStatusClass(PluginInfo plugin)
    {
        return plugin.IsEnabled ? "enabled" : "disabled";
    }

    private string GetStatusText(PluginInfo plugin)
    {
        return plugin.IsEnabled ? "Enabled" : "Disabled";
    }

    public class PluginUpdateInfo
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string CurrentVersion { get; set; } = string.Empty;
        public string AvailableVersion { get; set; } = string.Empty;
    }
}
