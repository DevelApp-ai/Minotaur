@* Installed Plugins Component *@
@* 
 * Component for managing installed plugins.
 * Allows users to enable, disable, configure, and uninstall plugins.
 * *@

@using Microsoft.AspNetCore.Components
@using Minotaur.Core.Models.Plugins

<div class="installed-plugins">
    <div class="plugins-header">
        <h5><i class="bi bi-puzzle-fill"></i> Installed Plugins</h5>
        <div class="header-actions">
            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshPlugins">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CheckForUpdates">
                <i class="bi bi-arrow-down-up"></i> Check Updates
            </button>
        </div>
    </div>

    <!-- Filter/Sort -->
    <div class="plugins-filter">
        <div class="filter-left">
            <div class="input-group input-group-sm" style="width: 200px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" 
                       placeholder="Search..." 
                       @bind="searchText" 
                       @bind:event="oninput">
            </div>
        </div>
        <div class="filter-right">
            <select class="form-select form-select-sm" @bind="sortBy" style="width: 150px;">
                <option value="name">Sort by Name</option>
                <option value="version">Sort by Version</option>
                <option value="date">Sort by Install Date</option>
                <option value="status">Sort by Status</option>
            </select>
            <select class="form-select form-select-sm" @bind="filterStatus" style="width: 150px;">
                <option value="">All Statuses</option>
                <option value="enabled">Enabled</option>
                <option value="disabled">Disabled</option>
            </select>
        </div>
    </div>

    <!-- Plugin List -->
    <div class="plugins-list">
        @if (filteredPlugins.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-puzzle-fill fs-1"></i>
                <p>No plugins installed</p>
                <small>Install plugins from the gallery to extend Minotaur's functionality</small>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var plugin in filteredPlugins)
                {
                    <div class="list-group-item plugin-item">
                        <div class="plugin-main">
                            <div class="plugin-icon">
                                <i class="bi @GetPluginIcon(plugin)"></i>
                            </div>
                            <div class="plugin-info">
                                <div class="plugin-name">@plugin.Name</div>
                                <div class="plugin-version">v@plugin.Version</div>
                            </div>
                        </div>
                        <div class="plugin-status">
                            <span class="status-badge @GetStatusClass(plugin)">
                                @GetStatusText(plugin)
                            </span>
                        </div>
                        <div class="plugin-actions">
                            @if (plugin.IsEnabled)
                            {
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => TogglePlugin(plugin)">
                                    <i class="bi bi-pause-fill"></i> Disable
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => TogglePlugin(plugin)">
                                    <i class="bi bi-play-fill"></i> Enable
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ConfigurePlugin(plugin)">
                                <i class="bi bi-gear"></i> Configure
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => UninstallPlugin(plugin)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Bulk Actions -->
    @if (filteredPlugins.Count > 0)
    {
        <div class="bulk-actions">
            <div class="actions-left">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" 
                           @bind="selectAll" 
                           id="selectAll">
                    <label class="form-check-label" for="selectAll">
                        Select All
                    </label>
                </div>
            </div>
            <div class="actions-right">
                <button class="btn btn-sm btn-outline-primary" @onclick="EnableSelected">
                    <i class="bi bi-play-fill"></i> Enable Selected
                </button>
                <button class="btn btn-sm btn-outline-warning" @onclick="DisableSelected">
                    <i class="bi bi-pause-fill"></i> Disable Selected
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="UninstallSelected">
                    <i class="bi bi-trash"></i> Uninstall Selected
                </button>
            </div>
        </div>
    }

    <!-- Update Notifications -->
    @if (updatesAvailable.Count > 0)
    {
        <div class="update-notifications">
            <h6><i class="bi bi-arrow-up-circle"></i> Updates Available (@updatesAvailable.Count)</h6>
            <div class="updates-list">
                @foreach (var update in updatesAvailable)
                {
                    <div class="update-item">
                        <div class="update-info">
                            <strong>@update.Name</strong>
                            <small>v@update.AvailableVersion</small>
                        </div>
                        <div class="update-actions">
                            <button class="btn btn-sm btn-primary" @onclick="() => UpdatePlugin(update)">
                                <i class="bi bi-arrow-up"></i> Update
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

