@* Plugin Details Component *@
@* 
 * Component for viewing and configuring plugin details.
 * Shows comprehensive information about a plugin and its settings.
 * *@

@using Microsoft.AspNetCore.Components
@using Minotaur.Core.Models.Plugins

<div class="plugin-details">
    <div class="details-header">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Close">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <h5><i class="bi @GetPluginIcon(Plugin)"></i> @Plugin?.Name</h5>
        <div class="header-actions">
            @if (Plugin?.IsInstalled == true)
            {
                @if (Plugin.IsEnabled)
                {
                    <button class="btn btn-sm btn-outline-warning" @onclick="TogglePlugin">
                        <i class="bi bi-pause-fill"></i> Disable
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-success" @onclick="TogglePlugin">
                        <i class="bi bi-play-fill"></i> Enable
                    </button>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="SaveConfiguration">
                    <i class="bi bi-check"></i> Save
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="UninstallPlugin">
                    <i class="bi bi-trash"></i> Uninstall
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-primary" @onclick="InstallPlugin">
                    <i class="bi bi-plus"></i> Install
                </button>
            }
        </div>
    </div>

    @if (Plugin == null)
    {
        <div class="loading-state">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading plugin details...</p>
        </div>
    }
    else
    {
        <div class="details-body">
            <!-- Overview Tab -->
            <div class="detail-section">
                <div class="section-header">
                    <h6><i class="bi bi-info-circle"></i> Overview</h6>
                </div>
                <div class="section-body">
                    <div class="overview-grid">
                        <div class="overview-item">
                            <div class="item-label">Version</div>
                            <div class="item-value">v@Plugin.Version</div>
                        </div>
                        <div class="overview-item">
                            <div class="item-label">Author</div>
                            <div class="item-value">@Plugin.Author</div>
                        </div>
                        <div class="overview-item">
                            <div class="item-label">Category</div>
                            <div class="item-value">@Plugin.Category</div>
                        </div>
                        <div class="overview-item">
                            <div class="item-label">License</div>
                            <div class="item-value">@Plugin.License</div>
                        </div>
                        <div class="overview-item">
                            <div class="item-label">Website</div>
                            <div class="item-value">
                                <a href="@Plugin.WebsiteUrl" target="_blank">@Plugin.WebsiteUrl</a>
                            </div>
                        </div>
                        <div class="overview-item">
                            <div class="item-label">Download Date</div>
                            <div class="item-value">@Plugin.InstallDate.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                    <div class="overview-description">
                        <p>@Plugin.Description</p>
                    </div>
                </div>
            </div>

            <!-- Metadata Tab -->
            <div class="detail-section">
                <div class="section-header">
                    <h6><i class="bi bi-tag"></i> Metadata</h6>
                </div>
                <div class="section-body">
                    <div class="tags-list">
                        @foreach (var tag in Plugin.Tags)
                        {
                            <span class="badge bg-secondary">@tag</span>
                        }
                    </div>
                    <div class="dependencies">
                        <h6>Dependencies</h6>
                        @if (Plugin.Dependencies.Count > 0)
                        {
                            <ul class="list-unstyled">
                                @foreach (var dep in Plugin.Dependencies)
                                {
                                    <li>@dep</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No dependencies</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Configuration Tab -->
            <div class="detail-section">
                <div class="section-header">
                    <h6><i class="bi bi-gear"></i> Configuration</h6>
                </div>
                <div class="section-body">
                    @if (Plugin.Configuration?.Count > 0)
                    {
                        <div class="config-form">
                            @foreach (var config in Plugin.Configuration)
                            {
                                <div class="config-item">
                                    <div class="config-header">
                                        <label for="@config.Key">@config.Key</label>
                                        <small class="text-muted">@config.Description</small>
                                    </div>
                                    <div class="config-control">
                                        @if (config.Type == "boolean")
                                        {
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" 
                                                       id="@config.Key" 
                                                       @bind="config.Value" 
                                                       @bind:event="onchange">
                                                <label class="form-check-label" for="@config.Key">
                                                    @(config.Value?.ToString().ToLower() == "true" ? "Enabled" : "Disabled")
                                                </label>
                                            </div>
                                        }
                                        else if (config.Type == "number")
                                        {
                                            <input type="number" class="form-control form-control-sm" 
                                                   id="@config.Key" 
                                                   @bind="config.Value" 
                                                   @bind:event="oninput">
                                        }
                                        else if (config.Type == "string")
                                        {
                                            <input type="text" class="form-control form-control-sm" 
                                                   id="@config.Key" 
                                                   @bind="config.Value" 
                                                   @bind:event="oninput">
                                        }
                                        else if (config.Type == "select")
                                        {
                                            <select class="form-select form-select-sm" 
                                                    id="@config.Key" 
                                                    @bind="config.Value" 
                                                    @bind:event="onchange">
                                                @foreach (var option in config.Options ?? new List<string>())
                                                {
                                                    <option value="@option">@option</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">This plugin has no configurable options</p>
                    }
                </div>
            </div>

            <!-- Documentation Tab -->
            <div class="detail-section">
                <div class="section-header">
                    <h6><i class="bi bi-book"></i> Documentation</h6>
                </div>
                <div class="section-body">
                    <div class="documentation-viewer">
                        @if (!string.IsNullOrEmpty(Plugin.Documentation))
                        {
                            <pre>@Plugin.Documentation</pre>
                        }
                        else
                        {
                            <p class="text-muted">No documentation available</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Changelog Tab -->
            @if (Plugin.Changelog?.Count > 0)
            {
                <div class="detail-section">
                    <div class="section-header">
                        <h6><i class="bi bi-clock-history"></i> Changelog</h6>
                    </div>
                    <div class="section-body">
                        <div class="changelog-list">
                            @foreach (var entry in Plugin.Changelog)
                            {
                                <div class="changelog-entry">
                                    <div class="entry-header">
                                        <strong>@entry.Version</strong>
                                        <small>@entry.Date.ToString("yyyy-MM-dd")</small>
                                    </div>
                                    <div class="entry-changes">
                                        @foreach (var change in entry.Changes)
                                        {
                                            <div class="change-item @GetChangeTypeClass(change.Type)">
                                                <span class="change-type">@change.Type</span>
                                                <span class="change-text">@change.Description</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
.plugin-details {
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    overflow: hidden;
    background: white;
}

.details-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
}

.details-header h5 {
    margin: 0;
    color: #495057;
    flex: 1;
}

.header-actions {
    display: flex;
    gap: 0.25rem;
}

.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #6c757d;
    text-align: center;
    padding: 2rem;
}

.loading-state .spinner-border {
    margin-bottom: 1rem;
}

.details-body {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
}

.detail-section {
    margin-bottom: 1.5rem;
}

.section-header {
    margin-bottom: 0.75rem;
}

.section-header h6 {
    margin: 0;
    color: #495057;
    font-size: 0.875rem;
}

.section-body {
    padding-left: 1rem;
}

.overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.overview-item {
    display: flex;
    flex-direction: column;
}

.item-label {
    font-size: 0.75rem;
    color: #6c757d;
    margin-bottom: 0.25rem;
}

.item-value {
    font-size: 0.875rem;
    color: #495057;
}

.overview-description {
    font-size: 0.875rem;
    color: #6c757d;
    line-height: 1.6;
}

.tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 1rem;
}

.dependencies {
    margin-top: 1rem;
}

.dependencies h6 {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: #495057;
}

.dependencies ul {
    margin: 0;
    padding-left: 1rem;
}

.dependencies li {
    font-size: 0.875rem;
    color: #6c757d;
}

.config-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.config-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.config-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.config-header label {
    font-weight: 500;
    font-size: 0.875rem;
    color: #495057;
}

.config-header small {
    font-size: 0.75rem;
}

.config-control {
    margin-top: 0.25rem;
}

.documentation-viewer {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 0.375rem;
    max-height: 300px;
    overflow-y: auto;
}

.documentation-viewer pre {
    margin: 0;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    white-space: pre-wrap;
    word-wrap: break-word;
}

.changelog-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.changelog-entry {
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    padding: 0.75rem;
}

.entry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.entry-header strong {
    font-size: 0.875rem;
}

.entry-header small {
    font-size: 0.75rem;
    color: #6c757d;
}

.entry-changes {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.change-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
}

.change-item.added {
    background: #d4edda;
}

.change-item.changed {
    background: #fff3cd;
}

.change-item.fixed {
    background: #e2e3e5;
}

.change-item.removed {
    background: #f8d7da;
}

.change-type {
    font-weight: 500;
    font-size: 0.75rem;
}

.change-text {
    color: #495057;
}
</style>

@code {
    [Parameter]
    public PluginInfo? Plugin { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnInstall { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnToggle { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnUninstall { get; set; }

    [Parameter]
    public EventCallback<PluginInfo> OnConfigure { get; set; }

    private void Close()
    {
        OnClose.InvokeAsync();
    }

    private void InstallPlugin()
    {
        if (Plugin != null)
        {
            OnInstall.InvokeAsync(Plugin);
        }
    }

    private void TogglePlugin()
    {
        if (Plugin != null)
        {
            Plugin.IsEnabled = !Plugin.IsEnabled;
            OnToggle.InvokeAsync(Plugin);
        }
    }

    private void UninstallPlugin()
    {
        if (Plugin != null)
        {
            OnUninstall.InvokeAsync(Plugin);
        }
    }

    private void SaveConfiguration()
    {
        if (Plugin != null)
        {
            OnConfigure.InvokeAsync(Plugin);
        }
    }

    private string GetPluginIcon(PluginInfo plugin)
    {
        return plugin.Category switch
        {
            "language" => "bi-translate",
            "visualization" => "bi-diagram-3",
            "export" => "bi-box-arrow-up-right",
            "analysis" => "bi-graph-up",
            "theme" => "bi-palette",
            _ => "bi-puzzle"
        };
    }

    private string GetChangeTypeClass(string type)
    {
        return type.ToLower() switch
        {
            "added" => "added",
            "changed" => "changed",
            "fixed" => "fixed",
            "removed" => "removed",
            _ => ""
        };
    }
}
