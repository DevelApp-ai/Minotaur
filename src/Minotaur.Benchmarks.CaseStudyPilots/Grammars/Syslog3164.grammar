// syslog RFC 3164 grammar for the issue #132 case-study pilot.
//
// The host/tag/message tail is a single colon-anchored absorb token: tokens
// that let the skippable whitespace inside a span float (nginx-style quoted
// tokens are fine because the quote anchors them; bare [^\n]*-style tails
// stall the lexer, LX1002) or that split host/tag/message into per-word
// tokens explode candidate paths at rhs-position-0. The walker splits
// the token value into host, tag and message around the first space and
// the following colon; timestamp may use RFC 3164's double-space day
// padding. Line sequence merges binary for whole-file parses.

Grammar: Syslog3164Pilot

<ws> ::= /[\x20\t]+/ => { skip }
<pri> ::= /<[0-9]{1,3}>/
<ts> ::= /[A-Z][a-z]{2}\x20+[0-9]{1,2}\x20[0-9]{2}:[0-9]{2}:[0-9]{2}/
<host_tag_msg> ::= /[^\n\x20\t]+[\x20][^\x20\t\n:]*:[^\n]*/
<eol> ::= /\r?\n/
<line> ::= <pri> <ts> <host_tag_msg> <eol> | <pri> <ts> <host_tag_msg>
<line_seq> ::= <line_seq> <line_seq> | <line>
